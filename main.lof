\contentsline {figure}{\numberline {4.1}{\ignorespaces FraudGraphBuilder --- Heterogeneous Graph Construction Architecture. The left panel shows the data transformation pipeline from raw tabular data to PyTorch Geometric Data object. The right panel illustrates the graph schema with 17 attribute node types organized into three categories: Categorical (blue), Bucketed Continuous (green), and Binary/Flag (orange), all connected to a central User node.}}{57}{figure.caption.18}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Architecture of the GNNFraudDetector (GraphSAGE). The pipeline processes node features through three SAGEConv layers with BatchNorm, filters to user nodes, then passes through two fully connected layers for binary classification.}}{70}{figure.caption.23}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Architecture of the Proposed Quantum GNN (PaperQGNN). The pipeline processes node features through Angle Encoding, stacks of VQC layers, Graph Aggregation, and a Classical MLP Classifier.}}{71}{figure.caption.25}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Split GNN Architecture --- The complete pipeline from input features to binary classification output.}}{72}{figure.caption.26}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces GraphSAGE Performance Comparison. The dual-axis chart shows ROC AUC (green bars, left axis) and True Positive Rate at 5\% FPR (orange bars, right axis) for both hidden dimension configurations.}}{79}{figure.caption.32}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Experiment 1 (Hidden Dim 128) --- ROC Curve and Confusion Matrix. The model achieved the best ROC AUC of 0.8859 with a TPR of 52.54\% at 5\% FPR.}}{80}{figure.caption.34}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Experiment 2 (Hidden Dim 64) --- ROC Curve and Confusion Matrix. The model achieved an AUC of 0.8829 with a TPR of 51.18\% at 5\% FPR.}}{80}{figure.caption.35}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Performance Comparison of QGNN Configurations. Dual-axis chart showing ROC AUC (blue, left) and TPR at 5\% FPR (orange, right).}}{81}{figure.caption.36}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Experiment 1 (16 Qubits, 1 Layers) --- ROC Curve and Confusion Matrix. Best QGNN configuration with AUC = 0.8769.}}{81}{figure.caption.38}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Experiment 4 (16 Qubits, 1 Layer) --- ROC Curve and Confusion Matrix. AUC = 0.8731.}}{82}{figure.caption.39}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Experiment 2 (6 Qubits, 1 Layer) --- ROC Curve and Confusion Matrix. AUC = 0.8602.}}{82}{figure.caption.40}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Experiment 3 (6 Qubits, 2 Layers) --- ROC Curve and Confusion Matrix. AUC = 0.8574.}}{82}{figure.caption.41}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Effect of $\gamma _{\text {edge}}$ on model performance --- best/mean/worst AUC (left) and fraud detection rate (right).}}{83}{figure.caption.42}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Effect of wavelet order $C$ on Test AUC --- distribution box plots (left) and best vs worst comparison (right).}}{83}{figure.caption.43}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Effect of split point $K$ on Test AUC --- distribution box plots (left) and interaction with wavelet order $C$ (right).}}{84}{figure.caption.45}%
\contentsline {figure}{\numberline {5.15}{\ignorespaces Complete heatmap of Test ROC AUC across all 45 experiments, organized by $(C, K)$ configuration and $\gamma _{\text {edge}}$ value.}}{84}{figure.caption.46}%
\contentsline {figure}{\numberline {5.16}{\ignorespaces Visual comparison of the top 10 configurations by Test ROC AUC and fraud detection rate.}}{85}{figure.caption.48}%
\contentsline {figure}{\numberline {5.17}{\ignorespaces Test ROC AUC comparison across all six data versions. The dashed blue line represents the base version benchmark (AUC = 0.8859).}}{88}{figure.caption.54}%
\contentsline {figure}{\numberline {5.18}{\ignorespaces True Positive Rate (TPR) at 5\% FPR threshold across all six data versions.}}{88}{figure.caption.55}%
\contentsline {figure}{\numberline {5.19}{\ignorespaces Confusion matrix components (TP, FN, FP) at 5\% FPR threshold across all six versions.}}{89}{figure.caption.56}%
\contentsline {figure}{\numberline {5.20}{\ignorespaces Generalization gap (Val AUC minus Test AUC) across all six data versions. Green bars indicate minimal overfitting (gap $\leq $ 0.02), orange bars indicate moderate overfitting (0.02--0.05), and red bars indicate severe overfitting (gap $>$ 0.05).}}{89}{figure.caption.57}%
