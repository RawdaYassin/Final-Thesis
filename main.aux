\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces Denoising Autoencoder architecture for tabular fraud detection. The pristine input vector undergoes stochastic tabular swap noise corruption (15\% column-wise probability) before being processed through the symmetric encoder--decoder stack. A target-isolation bypass line connects the original pristine input directly to the MSE loss evaluation node.}}{132}{figure.caption.92}\protected@file@percent }
\newlabel{fig:7.1}{{7.1}{132}{Denoising Autoencoder architecture for tabular fraud detection. The pristine input vector undergoes stochastic tabular swap noise corruption (15\% column-wise probability) before being processed through the symmetric encoder--decoder stack. A target-isolation bypass line connects the original pristine input directly to the MSE loss evaluation node}{figure.caption.92}{}}
\newlabel{eq:7.5}{{7.5}{132}{Denoising Autoencoders (DAEs) and Marginal-Preserving Tabular Corruption}{equation.7.5}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.0.2.3}Variational Autoencoders (VAEs) and Probabilistic Manifold Topologies}{132}{subsubsection.7.0.2.3}\protected@file@percent }
\newlabel{eq:7.6}{{7.6}{132}{Variational Autoencoders (VAEs) and Probabilistic Manifold Topologies}{equation.7.6}{}}
\newlabel{eq:7.7}{{7.7}{132}{Variational Autoencoders (VAEs) and Probabilistic Manifold Topologies}{equation.7.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces Variational Autoencoder architecture (pure baseline). The encoder projects the 41-dimensional input through dense layers (64, 32 ReLU) before branching into parallel $\mathbf  {z}_{\text  {mean}}$ and $\mathbf  {z}_{\log \text  {var}}$ heads. The reparameterization block generates the latent vector via $\mathbf  {z} = \mathbf  {z}_{\text  {mean}} + \exp (0.5 \cdot \mathbf  {z}_{\log \text  {var}}) \cdot \boldsymbol  {\epsilon }$, where $\boldsymbol  {\epsilon } \sim \mathcal  {N}(\mathbf  {0}, \mathbf  {I})$. The decoder mirrors the encoder structure, and the total loss combines RMSE reconstruction with $\beta $-weighted KL divergence.}}{133}{figure.caption.93}\protected@file@percent }
\newlabel{fig:7.2}{{7.2}{133}{Variational Autoencoder architecture (pure baseline). The encoder projects the 41-dimensional input through dense layers (64, 32 ReLU) before branching into parallel $\mathbf {z}_{\text {mean}}$ and $\mathbf {z}_{\log \text {var}}$ heads. The reparameterization block generates the latent vector via $\mathbf {z} = \mathbf {z}_{\text {mean}} + \exp (0.5 \cdot \mathbf {z}_{\log \text {var}}) \cdot \boldsymbol {\epsilon }$, where $\boldsymbol {\epsilon } \sim \mathcal {N}(\mathbf {0}, \mathbf {I})$. The decoder mirrors the encoder structure, and the total loss combines RMSE reconstruction with $\beta $-weighted KL divergence}{figure.caption.93}{}}
\newlabel{eq:7.8}{{7.8}{133}{Variational Autoencoders (VAEs) and Probabilistic Manifold Topologies}{equation.7.8}{}}
\newlabel{eq:7.9}{{7.9}{133}{}{equation.7.9}{}}
\newlabel{eq:7.10}{{7.10}{134}{}{equation.7.10}{}}
\newlabel{eq:7.11}{{7.11}{134}{}{equation.7.11}{}}
\newlabel{eq:7.12}{{7.12}{134}{}{equation.7.12}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.0.2.4}Information Fusion Hybridization and Downstream Stacking Loops}{134}{subsubsection.7.0.2.4}\protected@file@percent }
\newlabel{eq:7.13}{{7.13}{135}{Information Fusion Hybridization and Downstream Stacking Loops}{equation.7.13}{}}
\newlabel{eq:7.14}{{7.14}{135}{Information Fusion Hybridization and Downstream Stacking Loops}{equation.7.14}{}}
\newlabel{eq:7.15}{{7.15}{135}{Information Fusion Hybridization and Downstream Stacking Loops}{equation.7.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces DAE-based information fusion pipeline for fraud detection. The trained Tabular DAE processes the 53-dimensional raw feature vector, extracting compressed latent embeddings ($\mathbf  {z} \in \mathbb  {R}^{12}$), element-wise absolute errors ($|\mathbf  {e}| \in \mathbb  {R}^{53}$), and global MSE score ($s_{\text  {MSE}}$). These features are concatenated with the original vector, oversampled via SMOTE, and passed to the downstream XGBoost meta-learner for final fraud probability inference.}}{136}{figure.caption.94}\protected@file@percent }
\newlabel{fig:7.3}{{7.3}{136}{DAE-based information fusion pipeline for fraud detection. The trained Tabular DAE processes the 53-dimensional raw feature vector, extracting compressed latent embeddings ($\mathbf {z} \in \mathbb {R}^{12}$), element-wise absolute errors ($|\mathbf {e}| \in \mathbb {R}^{53}$), and global MSE score ($s_{\text {MSE}}$). These features are concatenated with the original vector, oversampled via SMOTE, and passed to the downstream XGBoost meta-learner for final fraud probability inference}{figure.caption.94}{}}
\newlabel{eq:7.16}{{7.16}{137}{Information Fusion Hybridization and Downstream Stacking Loops}{equation.7.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.4}{\ignorespaces Hybrid VAE--Logistic Regression pipeline. The Gaussian $\beta $-VAE processes the 41-dimensional input, extracting the NLL reconstruction score and KL divergence. These are concatenated with the original features to form a 43-dimensional standardized vector, which is passed to a supervised Logistic Regression classifier for fraud probability estimation.}}{137}{figure.caption.95}\protected@file@percent }
\newlabel{fig:7.4}{{7.4}{137}{Hybrid VAE--Logistic Regression pipeline. The Gaussian $\beta $-VAE processes the 41-dimensional input, extracting the NLL reconstruction score and KL divergence. These are concatenated with the original features to form a 43-dimensional standardized vector, which is passed to a supervised Logistic Regression classifier for fraud probability estimation}{figure.caption.95}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.5}{\ignorespaces Expanded hybrid VAE model with rich latent features. In addition to NLL and KL divergence, the VAE latent representation $\mathbf  {z}_{\text  {mean}}$ (4-dimensional) and its L2-normalized magnitude $\mathbf  {z}_{\text  {norm}}$ (4-dimensional) are extracted and concatenated with the original 41 features, yielding a 51-dimensional enriched vector processed by a tuned L2-regularized Logistic Regression classifier.}}{138}{figure.caption.96}\protected@file@percent }
\newlabel{fig:7.5}{{7.5}{138}{Expanded hybrid VAE model with rich latent features. In addition to NLL and KL divergence, the VAE latent representation $\mathbf {z}_{\text {mean}}$ (4-dimensional) and its L2-normalized magnitude $\mathbf {z}_{\text {norm}}$ (4-dimensional) are extracted and concatenated with the original 41 features, yielding a 51-dimensional enriched vector processed by a tuned L2-regularized Logistic Regression classifier}{figure.caption.96}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.6}{\ignorespaces Stacked hybrid VAE model with score-level meta-classification. The $\beta $-VAE generates anomaly scores (NLL$+\alpha \cdot $KL), which are fed alongside original features to Level-0 base classifiers (Logistic Regression and XGBoost). The three independent probability scores are then combined by a Logistic Regression meta-learner to produce the final fraud probability.}}{138}{figure.caption.97}\protected@file@percent }
\newlabel{fig:7.6}{{7.6}{138}{Stacked hybrid VAE model with score-level meta-classification. The $\beta $-VAE generates anomaly scores (NLL$+\alpha \cdot $KL), which are fed alongside original features to Level-0 base classifiers (Logistic Regression and XGBoost). The three independent probability scores are then combined by a Logistic Regression meta-learner to produce the final fraud probability}{figure.caption.97}{}}
